{
  "version": 2,
  "framework": null,
  "functions": {
    "api/auth/index.js":                { "memory": 256, "maxDuration": 10 },
    "api/baron-chat/index.js":          { "memory": 256, "maxDuration": 60 },
    "api/generate-macro-plan/index.js": { "memory": 256, "maxDuration": 60 },
    "api/generate-plan/index.js":       { "memory": 256, "maxDuration": 60 },
    "api/generate-questions/index.js":  { "memory": 256, "maxDuration": 60 },
    "api/lessons/index.js":             { "memory": 256, "maxDuration": 10 },
    "api/performance/index.js":         { "memory": 256, "maxDuration": 10 },
    "api/progress/index.js":            { "memory": 256, "maxDuration": 10 },
    "api/questions/index.js":           { "memory": 256, "maxDuration": 10 },
    "api/simulado/index.js":            { "memory": 256, "maxDuration": 60 },
    "api/subjects/index.js":            { "memory": 256, "maxDuration": 10 },
    "api/users/index.js":               { "memory": 256, "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/((?!api/)(?!.*\\.\\w{2,5}$).*)", "destination": "/public/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
